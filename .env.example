# 将本文件复制为当前目录的 .env，或把等价配置放在仓库根目录 .env。
# 不要提交真实 API Key。
CONTENT_AI_PROVIDER=deepseek
CONTENT_AI_BASE_URL=https://api.deepseek.com
CONTENT_AI_API_KEY=
CONTENT_AI_MODEL=deepseek-v4-pro
CONTENT_AI_FALLBACK_MODELS=deepseek-v4-flash

# 默认使用 real + rss；缺少 API Key 时启动失败，不会静默降级为 Mock。
# 仅在明确需要离线开发或固定回归时设置 mock + fixture。
INTEL_RADAR_MODEL_MODE=real
INTEL_RADAR_SOURCE_MODE=rss
INTEL_RADAR_FEED_DISCOVERY_MAX_DOCUMENTS=96
INTEL_RADAR_FEED_EVIDENCE_MAX_DOCUMENTS=30
INTEL_RADAR_FEED_FULLTEXT_MAX_DOCUMENTS=36
INTEL_RADAR_FEED_PER_SOURCE_CAP=4
INTEL_RADAR_FEED_PER_PUBLISHER_CAP=6
INTEL_RADAR_FEED_SUPPLY_EXPANSION_ENABLED=true
INTEL_RADAR_QUALITY_OBSERVABILITY_ENABLED=true
INTEL_RADAR_STORY_CLUSTERING_ENABLED=true
INTEL_RADAR_CLAIM_EVAL_ENABLED=true
INTEL_RADAR_PERSONALIZATION_ENABLED=true

# 同时执行最多 2 个扫描；更多扫描保留为 queued，等待空闲执行槽。
INTEL_RADAR_MAX_CONCURRENT_RUNS=2

# Scheduler 已实现但默认关闭，避免启动服务后自动产生模型费用。
INTEL_RADAR_SCHEDULER_ENABLED=false
INTEL_RADAR_SCHEDULER_TIMEZONE=Asia/Shanghai
INTEL_RADAR_SCHEDULER_CATCH_UP_HOURS=6
